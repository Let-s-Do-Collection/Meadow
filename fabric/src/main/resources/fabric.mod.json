{
  "schemaVersion": 1,
  "id": "meadow",
  "version": "${version}",
  "name": "[Let's Do] Meadow",
  "description": "Cowbells on the alpine pasture, pine forests and meadows full of flowers. Milk your cows, press your own cheese wheels, stir a bubbling fondue and snap a photo of it all with your old camera.",
  "authors": [
    "satisfy",
    "Jason13Official"
  ],
  "contributors": [
    "MissLilitu"
  ],
  "contact": {
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/meadow/",
    "sources": "https://github.com/Let-s-Do-Collection/Meadow",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.meadow.fabric.MeadowFabric"
    ],
    "client": [
      "net.satisfy.meadow.fabric.client.MeadowFabricClient"
    ],
    "rei_client": [
      "net.satisfy.meadow.fabric.core.rei.MeadowReiClientPluginFabric"
    ],
    "emi": [
      "net.satisfy.meadow.core.compat.emi.MeadowEmiPlugin"
    ],
    "jei_mod_plugin": [
      "net.satisfy.meadow.core.compat.jei.MeadowJEIPlugin"
    ],
    "modmenu": [
      "net.satisfy.meadow.fabric.core.config.ModMenu"
    ]
  },
  "mixins": [
    "meadow-common.mixins.json",
    "meadow.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "architectury": ">=13.0.8",
    "foundation": ">=1.0.7",
    "cloth-config": "*"
  }
}
